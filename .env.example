# REQUIRED - assumed account equity in USD for advisory sizing.
# This is NOT live equity. No exchange account is observed.
# Bot will FAIL CLOSED if this is missing or invalid.
ASSUMED_ACCOUNT_EQUITY_USD=2400

# Telegram (optional - bot runs in dry-run without these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional separate destination for rate-limited ERROR/CRITICAL notifications.
TELEGRAM_ERROR_CHAT_ID=
TELEGRAM_DRY_RUN=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
